<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
	</startup>

	<appSettings>
		<!-- Aktifkan DPI auto-scaling untuk kontrol di Windows Forms -->
		<add key="EnableWindowsFormsHighDpiAutoResizing" value="true"/>
	</appSettings>

	<windowsForms>
		<!-- Wajib di .NET 4.7+ agar layout auto-resize terhadap scaling monitor -->
		<highDpiMode>SystemAware</highDpiMode>
	</windowsForms>

	<runtime>
		<AppContextSwitchOverrides value="Switch.System.Windows.Forms.EnableWindowsFormsHighDpiAutoResizing=true"/>
	</runtime>
</configuration>
